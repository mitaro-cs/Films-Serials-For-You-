{
  "name": "fsfy-web",
  "private": true,
  "version": "0.7.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:tv": "svelte-kit sync && vite build -c vite.tv.config.ts",
    "build": "npm run build:tv && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tv/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  }
}
